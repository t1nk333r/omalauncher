panel "app drawer" {
  // The app drawer: swiping up on home opens it, above the prompt bar, and search shows it too. It's a panel like any
  // other, so it's yours to change: ask your agent to edit it. .stock-drawer.owl next to it is this file as the launcher
  // ships it, kept up to date: compare the two to see what changed in a newer launcher.
  //
  // Phone build: style.toml's drawer.* settings (layout, categories, sort, sections, most used, letters, labels, columns,
  // icon size) shape it; groups, hidden apps and picking several apps are the launcher's, and android.drawer and
  // `picked` tell it them.
  meta { description: "The launcher's app drawer, written in owl: your apps by kind and your groups, in one list or a page per category as Smart Launcher's, the most used, a letter rail, search as you type in the prompt bar, each app's long-press menu, picking several, and dragging an app onto home"; version: "1.2"; license: "MIT"; category: "system"; owl: 11 }
  // The launcher's gear, as its settings buttons draw it; currentColor takes the accent.
  asset gear = base64""
  // Each page's icon in the bar under the pages: Smart Launcher's own while it's on the phone (d.categoryIcons), else
  // these, its look in Tabler Icons (MIT, tabler.io/icons); contacts is Tabler's message-circle with three dots.
  asset iContacts = base64""
  asset iInternet = base64""
  asset iGames = base64""
  asset iMedia = base64""
  asset iUtilities = base64""
  asset iSettings = base64""
  asset iSocial = base64""
  asset iPhotography = base64""
  asset iNavigation = base64""
  asset iReading = base64""
  asset iMusic = base64""
  asset iEntertainment = base64""
  asset iProductivity = base64""
  asset iShopping = base64""
  asset iPersonalization = base64""
  asset iFinance = base64""
  asset iBusiness = base64""
  asset iEducation = base64""
  asset iTravel = base64""
  asset iLifestyle = base64""
  asset iFitness = base64""
  asset iSport = base64""
  asset iWeather = base64""
  asset iSmartHome = base64""
  asset iMedical = base64""
  asset iWearable = base64""
  asset iVideo = base64""
  asset iPhotos = base64""
  asset iNews = base64""
  asset iMaps = base64""
  asset iAccessibility = base64""
  asset iOther = base64""
  asset iGroup = base64""
  asset iLinux = base64""
  asset iShortcuts = base64""
  asset iApps = base64""
  asset iWork = base64""
  source d = android.drawer
  source ag = android.agents
  // The app whose long-press menu is open, by key, and the shortcuts it offers: null while they load, and the menu
  // waits for them, so it opens whole rather than growing.
  state menu = ""
  state menuShortcuts = null
  state tab = "personal"
  // The result picked with the arrow or Tab keys: -1 for the ask row, -2 for the web's; null follows the ranking.
  state pick = null
  // With style's drawer.layout "pages", the page showing, by its id: it stays put as pages come and go.
  state at = ""

  let st = d.style
  let icon = st.icon ?? 52
  // As many as fit, each a little wider than its icon, unless style sets how many.
  let cols = st.columns ?? max(1, floor(((screenWidth ?? 400) - 24) / (icon + 24)))
  let typed = trim(query)
  let searching = typed != ""
  let picking = picked != null
  let paged = st.layout == "pages"
  let workTab = d.work != null && tab == "work"
  // Hidden apps are listed, dimmed, only while showHidden; the most-used row never has them.
  let shown = d.apps.filter(a => !a.hidden || showHidden)
  // In style's drawer.sort order: A to Z, by use (most first) or by install (newest first); ties A to Z.
  let ordered = shown.sortBy(a => lower(a.name)).sortBy(a => st.sort == "used" ? -a.score : st.sort == "new" ? -a.installed : 0)
  // An app in one of your groups is listed there, on the personal tab, not under its usual heading.
  let grouped = flatten(d.groups.map(g => g.keys))
  let rest = ordered.filter(a => !a.work && indexOf(grouped, a.key) < 0)
  let top = st.suggestions ? d.apps.filter(a => !a.work && !a.hidden && a.score > 0).sortBy(a => -a.score).take(cols) : []
  let sections = paged ? [] : workTab ? [
      {id: "w-shortcuts", title: "shortcuts", apps: ordered.filter(a => a.work && a.kind == "shortcut")},
      {id: "w-apps", title: d.work.paused ? "work apps paused" : "work apps", apps: ordered.filter(a => a.work && a.kind == "android"), work: true}
    ] : flatten([
      [{id: "most", title: "most used", apps: top}],
      d.groups.map(g => {id: "g:" + g.name, title: g.name, group: g.name, apps: ordered.filter(a => !a.work && indexOf(g.keys, a.key) >= 0)}),
      st.sections ? [
        {id: "apps", title: "apps", apps: rest.filter(a => a.kind == "owl")},
        {id: "linux", title: "linux", apps: rest.filter(a => a.kind == "linux"), linux: true},
        // Usually few and just added: between the Linux and the Android apps, not past all the Android ones.
        {id: "shortcuts", title: "shortcuts", apps: rest.filter(a => a.kind == "shortcut")},
        // With headings each section runs A to Z on its own: the letter rail goes through Android's, the long one.
        {id: "android", title: "android", apps: rest.filter(a => a.kind == "android"), rail: true}
      ] : [{id: "all", title: null, apps: rest, rail: true}]
    ])
  // A title, then rows of cols apps. Groups keep their title while empty, and without Linux its section offers to install it.
  let rows = flatten(sections.filter(s => len(s.apps) > 0 || s.group != null || s.work == true || (s.linux == true && !linux)).map(s => flatten([
      s.title == null ? [] : [{key: "h:" + s.id, title: s.linux == true && !linux ? "linux apps" : s.title, group: s.group, work: s.work, offer: s.linux == true && !linux, similar: s.id == "android"}],
      chunk(s.apps, cols).map((cells, r) => {key: s.id + ":" + r, cells: cells, rail: s.rail == true})
    ])))
  // Beside the list while sorted A to Z (style's drawer.letters): each letter jumps to the first row with an app
  // starting with it, '#' for the rest, last.
  let railCells = flatten(rows.filter(r => r.rail == true).map(r => r.cells.map(a => {letter: a.letter, key: r.key})))
  let firsts = groupBy(railCells, c => c.letter)
  let letters = flatten([sort(keys(firsts).filter(l => l != "#")), get(firsts, "#") != null ? ["#"] : []])
  let rail = st.letters && !searching ? letters.map(l => {label: l, key: first(get(firsts, l)).key}) : []

  // With style's drawer.layout "pages", as Smart Launcher's app page: a page for each category Android apps fall in
  // (drawer.categories: Smart Launcher's six, or the kinds apps declare), each of your groups, then Linux apps,
  // shortcuts, owl apps and work apps. A group named for a category, in any case, adds its apps to that page, so the
  // group pickers move an app to one. Pages with no apps are left out, but your groups, and the offers to install Linux
  // and to turn work apps on.
  let smart = st.categories != "android"
  // Smart Launcher's six, then its further categories as style adds them (drawer.extra-categories). An app goes to
  // its extra category once that's added, else to its first six's, as Smart Launcher sorts them.
  let extras = smart ? st.extras ?? [] : []
  let kinds = smart ? flatten([["contacts", "internet", "games", "media", "utilities", "settings"], extras]) : ["games", "audio", "video", "photos", "social", "news", "maps", "productivity", "accessibility", "other"]
  let ownIcons = {
    contacts: iContacts, internet: iInternet, games: iGames, media: iMedia, utilities: iUtilities, settings: iSettings,
    social: iSocial, photography: iPhotography, navigation: iNavigation, reading: iReading, music: iMusic,
    entertainment: iEntertainment, productivity: iProductivity, shopping: iShopping, personalization: iPersonalization,
    finance: iFinance, business: iBusiness, education: iEducation, travel: iTravel, lifestyle: iLifestyle, fitness: iFitness,
    sport: iSport, weather: iWeather, "smart home": iSmartHome, medical: iMedical, wearable: iWearable,
    audio: iMusic, video: iVideo, photos: iPhotos, news: iNews, maps: iMaps, accessibility: iAccessibility, other: iOther,
    group: iGroup, linux: iLinux, shortcuts: iShortcuts, apps: iApps, work: iWork
  }
  let slIcons = d.categoryIcons ?? {}
  let pages = !paged ? [] : flatten([
      kinds.map(k => {
        id: "c:" + k, title: k, icon: get(slIcons, k, get(ownIcons, k)), group: find(d.groups, g => lower(g.name) == k).name,
        apps: ordered.filter(a => !a.work && (indexOf(grouped, a.key) >= 0 ? any(d.groups, g => lower(g.name) == k && indexOf(g.keys, a.key) >= 0) : a.kind == "android" && (smart ? (a.smartExtra != null && indexOf(extras, a.smartExtra) >= 0 ? a.smartExtra : a.smart) : a.category ?? "other") == k))
      }),
      // A group named for a category not shown has that category's icon, else a folder.
      d.groups.filter(g => indexOf(kinds, lower(g.name)) < 0).map(g => {
        id: "g:" + g.name, title: g.name, icon: get(slIcons, lower(g.name), get(ownIcons, lower(g.name), get(slIcons, "group", iGroup))), group: g.name, keep: true,
        apps: ordered.filter(a => !a.work && indexOf(g.keys, a.key) >= 0)
      }),
      [
        {id: "linux", title: linux ? "linux" : "linux apps", icon: iLinux, apps: rest.filter(a => a.kind == "linux"), offer: !linux, keep: !linux},
        {id: "shortcuts", title: "shortcuts", icon: iShortcuts, apps: rest.filter(a => a.kind == "shortcut")},
        {id: "apps", title: "apps", icon: iApps, apps: rest.filter(a => a.kind == "owl")},
        {id: "work", title: d.work != null && d.work.paused ? "work apps paused" : "work apps", icon: iWork, apps: ordered.filter(a => a.work), work: true, keep: d.work != null}
      ]
    ]).filter(pg => len(pg.apps) > 0 || pg.keep == true)
  let pageIds = pages.map(pg => pg.id)
  let pageAt = max(0, indexOf(pageIds, at))
  let shownPage = len(pages) > 0 ? pages[pageAt] : null
  // The bar's slots share its width, edge to edge, while each gets 36 dp or more; past that they're 44 dp and it scrolls.
  let barFits = len(pages) * 36 <= (screenWidth ?? 400) - 24

  // Every profile's apps match while typing, best first; the list runs up from the bar, so the best sits right above it.
  let hits = searching ? rank(shown, typed) : []
  let hitRows = chunk(hits, cols).map((cells, r) => {key: "q:" + r, start: r * cols, cells: cells})
  // Enter opens the best match when it names an app well, as the bar does; else the agent, or the web without one.
  let opens = len(hits) > 0 && strongMatch(hits[0], typed)
  let fallback = opens ? 0 : d.asks ? -1 : -2
  // What Enter acts on: a result by its place in hits, -1 for the ask row or -2 for the web's.
  let chosen = pick == null ? fallback : pick < 0 ? pick : len(hits) > 0 ? min(pick, len(hits) - 1) : fallback
  // Up the panel from the bar: the ask row, the web's, then the apps.
  let order = flatten([[-1, -2], range(len(hits))])
  let agent = ag.default
  let hiddenCount = count(d.apps, a => a.hidden)
  // Picked apps as the drawer lists them, for what the picking bar offers.
  let pickedApps = picking ? d.apps.filter(a => indexOf(picked, a.key) >= 0) : []
  // Groups are the personal tab's: none for work apps.
  let canGroup = any(pickedApps, a => !a.work)
  let canHide = any(pickedApps, a => !a.hidden)
  let canShow = any(pickedApps, a => a.hidden)
  // Android apps can be uninstalled together; Android asks about each in turn.
  let canUninstall = any(pickedApps, a => indexOf(a.actions, "uninstall") >= 0)
  // The kinds of app their developers declared (games, social, ...), each with its apps not in a group yet: what
  // "group similar" puts together. Work apps and hidden ones stay where they are.
  let freeKinds = groupBy(d.apps.filter(a => a.category != null && !a.work && !a.hidden && indexOf(grouped, a.key) < 0), a => a.category)
  let canGroupSimilar = any(values(freeKinds), apps => len(apps) >= 2)
  let words = {pin: "add to home", info: "app info", uninstall: "uninstall", remove: "remove", edit: "edit", share: "share", dock: "add to dock", undock: "remove from dock", customize: "customize", hide: "hide", unhide: "unhide", select: "select several", similar: "group similar"}

  // With a keyboard: Up and Tab move the pick away from the bar, Down and Shift+Tab back; the ask row sits lowest.
  onKey: {
    if searching && !picking {
      pick = order[clamp(max(0, indexOf(order, chosen)) + (value == "up" || value == "tab" ? 1 : -1), 0, len(order) - 1)]
    }
  }
  // Typing starts the pick over, at the best match.
  on typed { pick = null }
  // Carried out onto home, its menu gives way to the drag.
  on dragging { menu = "" }

  // How much the drawer covers home: near-opaque, as home's widgets showing through make the icons hard to read.
  // Phone build: the drawer's backdrop follows style.toml's drawer.opacity, so this stays a default for copies in panels/.
  // keyboard: false (with owl: 15 in meta) leaves the keyboard down as the drawer opens, until the bar is tapped.
  enter: searching && !picking ? (chosen >= 0 ? "▸ open" : chosen == -2 ? "↗ search" : "⏎ ask") : ""
  // An empty bar's Enter does nothing, as on home; nor does one while apps are picked, so the picks stay.
  onSubmit: {
    if searching && !picking {
      if chosen >= 0 {
        open(hits[chosen].key)
      } else if chosen == -2 {
        launcher("web")
      } else {
        launcher("ask")
      }
    }
  }

  // An app's icon as the drawer draws it: its own, its silhouette on a badge with monochrome icons, or its initials.
  component AppIcon(a) {
    Box {
      size: icon
      align: center
      radius: icon / 2 * corners
      background: a.hasIcon && !d.monochrome ? transparent : surface
      if a.hasIcon {
        Image { src: a.icon; size: d.monochrome ? icon * 36 / 52 : icon; tint: d.monochrome ? accent : null; label: a.label }
      } else {
        Text { text: a.initials; fontSize: 18 * icon / 52; color: accent }
      }
    }
  }

  // One app: framed when Enter would open it or it's picked. While picking, a tap or long-press picks or unpicks it;
  // otherwise a tap opens it, a long-press opens its menu, and a long-press then a drag carries it onto home or the dock.
  component Cell(a, framed, named) {
    Column {
      weight: 1
      align: center
      gap: 6
      padding: [4, 10]
      radius: 16 * corners
      border: framed || indexOf(picked ?? [], a.key) >= 0 ? 2 : 0
      borderColor: accent
      // Paused work apps and hidden ones show dimmed; opening a paused one turns work apps back on.
      opacity: a.paused || a.hidden ? 0.4 : 1
      dragApp: picking ? "" : a.key
      onTap: {
        if picking {
          appAction("select", a.key)
        } else {
          open(a.key)
        }
      }
      onLongPress: {
        if picking {
          appAction("select", a.key)
        } else {
          menuShortcuts = null
          menu = a.key
          menuShortcuts = shortcuts(a.key)
        }
      }
      Box {
        AppIcon { a: a }
        // Installed lately and not opened since.
        Box { visible: a.isNew; size: icon; align: topStart; Box { size: 10; radius: 5; background: accent } }
        Box {
          visible: indexOf(picked ?? [], a.key) >= 0
          size: icon
          align: topEnd
          Box { size: 20; radius: 10; background: accent; align: center; Text { text: "✓"; fontSize: 12; color: background } }
        }
      }
      // Always two lines tall, so a row keeps its height whichever apps fill it.
      Text { visible: named; text: a.name; fontSize: 12; align: center; maxLines: 2; minLines: 2; fill: width }
      Popup {
        visible: menu == a.key && menuShortcuts != null && dragging == null
        position: above
        onDismiss: menu = ""
        width: 200
        gap: 0
        // The app's shortcuts first, as stock launchers list them: tap to open, + to put one on home.
        for s in menuShortcuts key s.key {
          Row {
            fill: width
            align: center
            gap: 10
            padding: [12, 6]
            onTap: { menu = ""; open(s.key) }
            Image { src: s.icon; size: 24; tint: d.monochrome ? accent : null; label: s.name }
            Text { text: s.name; weight: 1; maxLines: 1 }
            Text { text: "[+]"; color: accent; onTap: { menu = ""; appAction("pin", s.key) } }
          }
        }
        Spacer { visible: len(menuShortcuts) > 0; height: 1; fill: width; background: border }
        // Its own entries, then the dock while it shows, then customize, grouping it with apps like it (its group, else
        // one named for its kind), hide or unhide, and picking several.
        for w in flatten([a.actions, d.dock.shown ? (a.docked ? ["undock"] : d.dock.full ? [] : ["dock"]) : [], ["customize"], a.category != null && !a.work && !a.hidden && len(get(freeKinds, a.category ?? "", [])) >= (indexOf(grouped, a.key) >= 0 ? 1 : 2) ? ["similar"] : [], [a.hidden ? "unhide" : "hide", "select"]]) key w {
          Text { text: get(words, w, w); fontSize: 15; fill: width; padding: [12, 12]; onTap: { menu = ""; appAction(w, a.key) } }
        }
      }
    }
  }

  // A page's icon in the bar: a tap turns to it; the one showing is in the accent and underlined.
  component BarTab(pg) {
    Column {
      fill: width
      align: center
      gap: 4
      padding: [0, 10, 0, 6]
      onTap: at = pg.id
      Image { src: pg.icon; size: 24; tint: shownPage != null && pg.id == shownPage.id ? accent : muted; label: pg.title }
      Box { width: 16; height: 2; background: shownPage != null && pg.id == shownPage.id ? accent : transparent }
    }
  }

  Column {
    gap: 0
    padding: [12, 0]
    Row {
      align: center
      padding: [0, 12, 0, 8]
      gap: 0
      // Pages: the one showing, as Smart Launcher titles its app page, and how many apps it has.
      Text { visible: paged && !searching && shownPage != null; text: shownPage != null ? shownPage.title : ""; fontSize: 20; maxLines: 1; padding: [8, 6] }
      Text { visible: paged && !searching && shownPage != null; text: shownPage != null ? "" + len(shownPage.apps) : ""; color: muted; maxLines: 1 }
      // Typing searches every profile, so the tabs step aside; pages give work apps one of their own.
      for t in d.work != null && !searching && !paged ? ["personal", "work"] : [] {
        Text { text: t; color: tab == t ? accent : muted; background: tab == t ? surface : transparent; radius: 18 * corners; padding: [14, 10]; onTap: tab = t }
      }
      Spacer { weight: 1 }
      // Lists the hidden apps too, dimmed, so they can be shown again; only while there are some. Behind the
      // fingerprint or screen lock with style's drawer.lock-hidden.
      Text {
        visible: hiddenCount > 0
        text: (showHidden ? "[hide hidden (" : "[show hidden (") + hiddenCount + ")]"
        color: showHidden ? accent : muted
        maxLines: 1
        padding: [8, 10]
        onTap: launcher("hidden")
      }
      Box {
        size: 44
        radius: 22 * corners
        background: surface
        align: center
        onTap: launcher("settings")
        Image { src: gear; size: 22; tint: accent; label: "settings" }
        // System updates are waiting: settings › system updates lists them.
        Box { visible: d.updates > 0; align: topEnd; size: 44; padding: 8; Box { size: 8; radius: 4; background: red } }
      }
    }
    Column {
      visible: !searching && !paged
      lazy: true
      weight: 1
      fill: width
      gap: 0
      rail: rail
      // Sideways to the other tab, as stock drawers' tabs turn: a finger moving left brings the work apps.
      onSwipe: {
        if d.work != null {
          tab = value == "left" ? "work" : "personal"
        }
      }
      for row in rows key row.key {
        if row.title != null {
          // A section's title, with a group's rename and ungroup, the work switch or the offer to install Linux at its end.
          Row {
            fill: width
            gap: 0
            align: center
            padding: [8, 12, 0, 4]
            Text { text: row.title; color: muted; weight: 1; maxLines: 1 }
            Text { visible: row.group != null; text: "[rename]"; color: accent; padding: [6, 8]; onTap: drawerGroup("rename", row.group) }
            Text { visible: row.group != null; text: "[ungroup]"; color: accent; padding: [6, 8]; onTap: drawerGroup("ungroup", row.group) }
            Text { visible: row.work == true; text: "[" + (d.work.paused ? "turn on" : "pause") + "]"; color: accent; padding: [6, 8]; onTap: workApps("toggle") }
            // Every kind with two or more apps not in a group yet becomes a group of its own.
            Text { visible: row.similar == true && canGroupSimilar; text: "[group similar]"; color: accent; padding: [6, 8]; onTap: appAction("similar", rest.map(a => a.key)) }
            Text { visible: row.offer == true; text: "[" + (d.linux == "installing" ? "installing…" : "install linux") + "]"; color: accent; padding: [6, 8]; onTap: launcher("linux") }
          }
        } else {
          Row {
            fill: width
            gap: 0
            for a in row.cells { Cell { a: a; framed: false; named: st.labels } }
            // A short last row keeps its cells the width of the others'.
            for s in range(0, cols - len(row.cells)) { Spacer { weight: 1 } }
          }
        }
      }
    }
    // Pages: one category at a time, swiped sideways, past the last round to the first; in each its apps in rows, as
    // the list has them.
    Pages {
      visible: paged && !searching
      weight: 1
      fill: width
      loop: true
      page: pageAt
      onPage: at = pageIds[value]
      for pg in pages key pg.id {
        Column {
          lazy: true
          fill: true
          gap: 0
          for row in flatten([pg.group != null || pg.work == true || pg.offer == true ? [{key: "do"}] : [], chunk(pg.apps, cols).map((cells, r) => {key: "" + r, cells: cells})]) key row.key {
            if row.cells == null {
              // A group's rename and ungroup, the work switch or the offer to install Linux, above its apps.
              Row {
                fill: width
                gap: 0
                align: center
                justify: end
                padding: [8, 0, 0, 4]
                Text { visible: pg.group != null; text: "[rename]"; color: accent; padding: [6, 8]; onTap: drawerGroup("rename", pg.group) }
                Text { visible: pg.group != null; text: "[ungroup]"; color: accent; padding: [6, 8]; onTap: drawerGroup("ungroup", pg.group) }
                Text { visible: pg.work == true; text: "[" + (d.work != null && d.work.paused ? "turn on" : "pause") + "]"; color: accent; padding: [6, 8]; onTap: workApps("toggle") }
                Text { visible: pg.offer == true; text: "[" + (d.linux == "installing" ? "installing…" : "install linux") + "]"; color: accent; padding: [6, 8]; onTap: launcher("linux") }
              }
            } else {
              Row {
                fill: width
                gap: 0
                for a in row.cells { Cell { a: a; framed: false; named: st.labels } }
                for s in range(0, cols - len(row.cells)) { Spacer { weight: 1 } }
              }
            }
          }
        }
      }
    }
    // The pages' icons, as Smart Launcher's bar: spread edge to edge, no gap after the last; too many to fit, it scrolls.
    Row {
      visible: paged && !searching && len(pages) > 1 && barFits
      fill: width
      gap: 0
      for pg in pages key pg.id { Box { weight: 1; BarTab { pg: pg } } }
    }
    Row {
      visible: paged && !searching && len(pages) > 1 && !barFits
      scroll: true
      gap: 0
      for pg in pages key pg.id { Box { width: 44; BarTab { pg: pg } } }
    }
    Column {
      visible: searching
      lazy: true
      reverse: true
      weight: 1
      fill: width
      gap: 0
      for row in hitRows key row.key {
        Row {
          fill: width
          gap: 0
          // Search results always say what matched.
          for a, i in row.cells { Cell { a: a; framed: !picking && row.start + i == chosen; named: true } }
          for s in range(0, cols - len(row.cells)) { Spacer { weight: 1 } }
        }
      }
    }
    // While picking: how many, and what to do with them all. Adding to home skips the ones already there.
    Column {
      visible: picking
      fill: width
      gap: 0
      padding: [4, 4]
      border: 2
      borderColor: accent
      radius: 16 * corners
      background: background
      Row {
        fill: width
        align: center
        gap: 0
        Text { text: len(picked ?? []) + " picked"; weight: 1; padding: [8, 0] }
        Text { text: "[cancel]"; color: muted; padding: [6, 8]; onTap: launcher("cancel") }
      }
      // Each on as many lines as it takes, so all of them fit a narrow screen.
      Row {
        gap: 0
        wrap: true
        Text { text: "[add to home]"; color: accent; padding: [6, 8]; onTap: appAction("pin", picked) }
        // Fills the dock's free slots in the order picked; the drawer closes to show it.
        Text { visible: d.dock.shown && !d.dock.full; text: "[add to dock]"; color: accent; padding: [6, 8]; onTap: appAction("dock", picked) }
      }
      Row {
        gap: 0
        wrap: true
        Text { visible: canGroup; text: "[group]"; color: accent; padding: [6, 8]; onTap: { appAction("group", picked); launcher("cancel") } }
        Text { visible: canHide; text: "[hide]"; color: accent; padding: [6, 8]; onTap: { appAction("hide", picked); launcher("cancel") } }
        Text { visible: canUninstall; text: "[uninstall]"; color: accent; padding: [6, 8]; onTap: { appAction("uninstall", picked); launcher("cancel") } }
        Text { visible: canShow; text: "[unhide]"; color: accent; padding: [6, 8]; onTap: { appAction("unhide", picked); launcher("cancel") } }
      }
    }
    // The lines above the bar that do something with what's typed: search the web, or ask the agent (lowest). Each is
    // outlined while it's what Enter does.
    Row {
      visible: searching && !picking
      fill: width
      gap: 4
      padding: [12, 10]
      border: chosen == -2 ? 2 : 0
      borderColor: accent
      radius: 16 * corners
      onTap: launcher("web")
      Text { text: "↗"; color: chosen == -2 ? accent : muted }
      Text { text: "search " + d.web + ": " + typed; color: chosen == -2 ? foreground : muted; maxLines: 1; weight: 1 }
    }
    Row {
      visible: searching && !picking
      fill: width
      gap: 4
      padding: [12, 10]
      border: chosen == -1 ? 2 : 0
      borderColor: accent
      radius: 16 * corners
      onTap: launcher("ask")
      Text { text: "⏎"; color: chosen == -1 ? accent : muted }
      Text {
        text: !linux ? "ask an agent · install linux" : agent == null ? "ask an agent · install one" : "ask " + agent.bin + ": " + typed
        color: chosen == -1 ? foreground : muted
        maxLines: 1
        weight: 1
      }
    }
  }
}
