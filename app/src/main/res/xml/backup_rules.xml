<?xml version="1.0" encoding="utf-8"?>
<!--
  Backups (Android 11 and older) leave out Linux: the rootfs is gigabytes, and its
  symlinks wouldn't survive a restore. Without the setup records a restored phone
  shows Linux as not installed, and installing it starts fresh. Omarchy's release
  (64 MB of themes) is downloaded again too. With both, a backup fits Android's
  25 MB quota; with either, it was skipped whole. Same list as
  data_extraction_rules.xml.

  Phone build: nor Feather backups' own settings (backup.xml), its sealed token and a
  staged restore: another install must get its own device ID, and the token only
  opens with this install's key anyway. The same for the PC agent's settings, token and
  record of what it wrote (pc_agent.xml, pc-agent-token, pc-agent/): a restored phone
  starts with it off. And the copies of widgets it replaced (widgets/.pc-agent-history),
  which could pass the quota on their own. The widget gallery's sealed GitHub token
  (gallery-token) stays out too: it only opens with this install's key.
-->
<full-backup-content>
    <exclude domain="file" path="arch" />
    <exclude domain="file" path="tmp" />
    <exclude domain="file" path="xdg" />
    <exclude domain="file" path="sys" />
    <exclude domain="file" path="proc" />
    <exclude domain="file" path="keymap.xkb" />
    <exclude domain="file" path="bwrap-shim" />
    <exclude domain="file" path="rootfs-steps.json" />
    <exclude domain="file" path="setup-agents" />
    <exclude domain="file" path="updates.json" />
    <exclude domain="file" path="omarchy" />
    <exclude domain="file" path=".omarchy.download" />
    <exclude domain="file" path="backup-token" />
    <exclude domain="file" path=".restore" />
    <exclude domain="file" path=".restore-kept" />
    <exclude domain="sharedpref" path="backup.xml" />
    <exclude domain="file" path="pc-agent-token" />
    <exclude domain="file" path="gallery-token" />
    <exclude domain="sharedpref" path="pc_agent.xml" />
    <exclude domain="file" path="pc-agent" />
    <exclude domain="file" path="widgets/.pc-agent-history" />
</full-backup-content>
